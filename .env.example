# Supabase transaction-pooler connection string (port 6543)
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:6543/postgres

# A long random secret used to protect one-time email codes
AUTH_SECRET=replace-with-at-least-32-random-characters

# Resend email delivery
RESEND_API_KEY=re_xxxxxxxxx
EMAIL_FROM=SER Teacher <noreply@your-domain.com>

# Optional during local development only. Never enable on Vercel.
DEV_SHOW_VERIFICATION_CODE=false
